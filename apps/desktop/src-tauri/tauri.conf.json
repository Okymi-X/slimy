{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slimy",
  "version": "0.1.0",
  "identifier": "dev.slimy.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Slimy",
        "width": 380,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
